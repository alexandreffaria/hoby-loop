# Hobby Loop Environment Configuration
# Copy this file to .env and update with your actual values

# ============================================
# Database Configuration
# ============================================

# PostgreSQL database name
DB_NAME=hobyloop

# PostgreSQL username
DB_USER=hoby

# PostgreSQL password (CHANGE IN PRODUCTION!)
DB_PASSWORD=password123

# PostgreSQL host (use 'postgres' for Docker, 'localhost' for local dev)
DB_HOST=localhost

# PostgreSQL port (5432 for Docker, 5433 for local dev if custom)
DB_PORT=5432

# SSL mode for database connection (disable, require, verify-ca, verify-full)
DB_SSLMODE=disable

# ============================================
# Backend Server Configuration
# ============================================

# Port for the Go backend server
SERVER_PORT=8080

# Gin mode (debug, release, test)
# Use 'release' for production
GIN_MODE=debug

# JWT secret key for authentication (CHANGE IN PRODUCTION!)
# Generate a strong random string for production use
JWT_SECRET=your-secret-key-change-in-production

# ============================================
# Frontend Configuration
# ============================================

# Frontend port (nginx)
FRONTEND_PORT=80

# API URL for frontend to connect to backend
# For Docker: http://backend:8080
# For local dev: http://localhost:8080
VITE_API_URL=http://localhost:8080

# ============================================
# Production Settings
# ============================================

# IMPORTANT: Before deploying to production:
# 1. Change DB_PASSWORD to a strong, unique password
# 2. Generate a strong JWT_SECRET (use: openssl rand -base64 32)
# 3. Set GIN_MODE=release
# 4. Set DB_SSLMODE=require (if your database supports it)
# 5. Update VITE_API_URL to your production backend URL
# 6. Never commit the actual .env file to version control

# ============================================
# Optional: Development Tools
# ============================================

# Enable CORS for all origins (development only)
# CORS_ALLOW_ALL=true

# Log level (debug, info, warn, error)
# LOG_LEVEL=info

# Database connection pool settings
# DB_MAX_OPEN_CONNS=25
# DB_MAX_IDLE_CONNS=5
# DB_CONN_MAX_LIFETIME=5m
